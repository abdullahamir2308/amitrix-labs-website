# Copy to .env.local (never commit real values). On Vercel, add these under
# Project → Settings → Environment Variables.

# Resend API key used by the contact form (/api/contact). Create one at https://resend.com/api-keys.
# If it's missing: in development the form logs the submission to the server console and still
# shows success (with a "dev mode" notice); in production the API answers 503 with a clear message.
RESEND_API_KEY=

# Inbox that receives contact-form notifications. Defaults to site.contact.email (src/lib/site.ts).
CONTACT_TO_EMAIL=hello@amitrixlabs.com

# Sender for notifications and the auto-reply. Must be on a domain verified in Resend
# (e.g. "Amitrix Labs <hello@amitrixlabs.com>"). For quick tests Resend allows "onboarding@resend.dev".
CONTACT_FROM_EMAIL="Amitrix Labs <noreply@amitrixlabs.com>"

# Cal.com booking link for the inline embed on /contact, as "username/event-slug" (e.g. "amitrix/30min").
# Overrides site.contact.calLink. While it's a placeholder, /contact shows a styled placeholder card.
NEXT_PUBLIC_CAL_LINK=
